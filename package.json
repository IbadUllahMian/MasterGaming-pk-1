{
  "name": "@app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": "~10.14.0"
  },
  "scripts": {
    "prebuild": "cp node_modules/@appsmithorg/kite-analytics/kite-analytics.js public/kite-analytics.js",
    "predev": "cp node_modules/@appsmithorg/kite-analytics/kite-analytics.js public/kite-analytics.js",
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx scripts/seed-payload.ts"
  },
  "dependencies": {
    "@appsmithorg/kite-analytics": "^1.1.0",
    "@appsmithorg/kite-ui": "^0.2.0",
    "@appsmithorg/template-backend": "^1.1.2",
