    "@appsmithorg/template-shared": "^1.0.4",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/live-preview-react": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "graphql": "^16.8.1",
    "lucide-react": "^0.525.0",
    "next": "16.2.11",
    "payload": "3.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "tw-animate-css": "^1.3.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^22.17.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "dompurify@>=3.0.0 <4.0.0": "3.4.13",
      "esbuild": "0.28.1",
      "find-my-way": "9.7.0",
      "form-data": "4.0.6",
      "immutable@>=4.0.0 <5.0.0": "4.3.9",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
      "sharp": "0.35.3",
      "fast-uri": "3.1.5",
      "postcss@<8.5.23": "8.5.23",
      "undici@>=7.0.0 <8.0.0": "7.29.0",
      "vite@>=8.0.0 <9.0.0": "8.0.16"
