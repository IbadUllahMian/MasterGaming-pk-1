{
  "name": "kite-team-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": "~10.14.0"
  },
  "scripts": {
    "generate:pages": "node scripts/generate-page-registry.mjs",
    "dev": "pnpm generate:pages && next dev -p 4321",
    "build": "pnpm typecheck && next build && node scripts/validate-public-reports.mjs",
    "start": "next start -p 4321",
    "typecheck": "pnpm generate:pages && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "jose": "6.2.3",
    "next": "16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "sharp": "0.35.3",
      "nanoid@>=3.0.0 <4.0.0": "3.3.17"
    }
  }
}
