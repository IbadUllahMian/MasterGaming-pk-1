NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_DISABLE_KITE_BADGE=false

# Forwarded by /api/v1/kite-platform/contact-form/submit to the Kite platform email API.
PLATFORM_BASE_URL=
PLATFORM_API_KEY=

# Used by the bot-prerender middleware (Prerender.io).
PRERENDER_TOKEN=

# Embedded Payload CMS. APP_DATABASE_URL is the per-app Neon Postgres (provisioned
# by the platform). PAYLOAD_SCHEMA isolates each design iteration in its own
# Postgres schema (payload_iter1/2/3); the selected iter's schema is carried into
# the promoted site. Left empty here on purpose: an unset schema means "use the
# connection's default", which is a working single-tenant setup, while a literal
# `public` names the one schema the Postgres adapter refuses.
# PAYLOAD_SECRET signs Payload sessions/tokens.
APP_DATABASE_URL=
PAYLOAD_SECRET=
PAYLOAD_SCHEMA=
