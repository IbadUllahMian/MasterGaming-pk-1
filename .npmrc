registry=https://registry.npmjs.org/
@appsmithorg:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN:-placeholder}

# Flat node_modules (npm-style) rather than pnpm's default symlinked store.
# Two things depend on it, both in the deployed bundle rather than locally:
#
#   * sharp's native binding finds libvips through an rpath
#     (`$ORIGIN/../../sharp-libvips-<platform>/lib`), which under pnpm's default
#     layout resolves through a symlink into the store.
#   * Vercel REFUSES a serverless package containing symlinked directories
#     ("The framework produced an invalid deployment package for a Serverless
#     Function"), so tracing that library in from the store fails the deploy
#     outright rather than shipping it.
#
# Hoisting makes `@img/sharp-<platform>` and `@img/sharp-libvips-<platform>`
# real sibling directories, so the rpath resolves inside the package and there
# is no symlink for Vercel to reject.
node-linker=hoisted
